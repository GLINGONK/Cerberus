{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerberus",
  "version": "0.1.0",
  "identifier": "com.cerberus.vault",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cerberus",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 GLINGONK",
    "shortDescription": "Encrypted password vault",
    "longDescription": "Cerberus stores credentials in a locally encrypted vault protected by a configurable cascade of ciphers and by several authentication factors combined.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["French", "English"]
      }
    }
  }
}
